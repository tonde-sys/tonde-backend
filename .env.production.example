# ═══════════════════════════════════════════════════════════════════════════
# TONDE — configuration de PRODUCTION
#
# Copier en .env.production (ignoré par Git) et remplacer TOUS les placeholders.
# Ne jamais committer ce fichier une fois rempli.
#
# Générer les secrets :
#   Linux/macOS : openssl rand -hex 32
#   PowerShell  : -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
# ═══════════════════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
APP_NAME=Tonde API
APP_VERSION=1.0.0
CREATE_TABLES_ON_STARTUP=false
# Render gratuit uniquement : applique `alembic upgrade head` au démarrage.
# Sur VPS/Compose, laisser false : les migrations sont un step séparé.
RUN_MIGRATIONS_ON_STARTUP=false

# ── Base de données ─────────────────────────────────────────────────────────
# Avec docker-compose.prod.yml, DATABASE_URL est construit automatiquement.
# Sur une plateforme managée, coller l'URL fournie (postgres:// est accepté).
DATABASE_URL=postgresql+asyncpg://tonde:CHANGE_ME@localhost:5432/tonde_db
POSTGRES_USER=tonde
POSTGRES_PASSWORD=CHANGE_ME_MOT_DE_PASSE_FORT
POSTGRES_DB=tonde_db

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────────────────────────────────────
# OBLIGATOIRE : au moins 32 caractères aléatoires.
JWT_SECRET_KEY=CHANGE_ME_32_CARACTERES_MINIMUM
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ────────────────────────────────────────────────────────────────────
# Liste d'origines séparées par des virgules. JAMAIS "*" en production.
# Exemple : https://app.tonde.bi,https://admin.tonde.bi
ALLOWED_ORIGINS=https://app.tonde.bi

# ── OTP SMS — Africa's Talking ──────────────────────────────────────────────
# Utiliser le compte de production, pas "sandbox". Vérifier la couverture
# du Burundi (+257) avant le pilote.
AFRICAS_TALKING_USERNAME=CHANGE_ME
AFRICAS_TALKING_API_KEY=CHANGE_ME
AFRICAS_TALKING_SENDER_ID=TONDE
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3

# ── Firebase Cloud Messaging (facultatif pour le pilote) ───────────────────
# FIREBASE_SERVICE_ACCOUNT_JSON accepte le JSON complet ou un chemin de fichier.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Moteur de file d'attente ────────────────────────────────────────────────
ABSENT_TIMEOUT_SECONDS=180
ABSENT_WARNING_SECONDS=120
ABSENT_RETURN_WINDOW_MINUTES=30
WAITING_TICKET_TTL_HOURS=12
SERVING_TICKET_TTL_HOURS=6
INCOMPLETE_TICKET_TTL_HOURS=24

# ── Scheduler ───────────────────────────────────────────────────────────────
# Laisser activé. Un seul worker/instance : le scheduler est in-process.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=5
MAINTENANCE_INTERVAL_SECONDS=60

# ── Limites ─────────────────────────────────────────────────────────────────
WS_CONNECT_LIMIT_PER_MINUTE=10
SYNC_WINDOW_DAYS=7
SYNC_MAX_ACTIONS=50
QR_TICKET_TTL_HOURS=24
EXPORT_MAX_ROWS=100000

# ── Reverse proxy (docker-compose.prod.yml) ─────────────────────────────────
# 127.0.0.1 = seul le reverse proxy local peut joindre l'API.
API_BIND_ADDRESS=127.0.0.1

# ── Bootstrap automatique (Render gratuit, sans shell) ───────────────────────
# JSON complet de bootstrap/pilot.example.json. Garder ces valeurs secrètes.
# BOOTSTRAP_CONFIG_JSON=
# BOOTSTRAP_PASSWORDS_JSON=
